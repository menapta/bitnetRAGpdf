# Caminho para a pasta com os PDFs
PDF_FOLDER=./documents

# Onde o ChromaDB será persistido
CHROMA_DB_PATH=./chroma_db

# Modelo de embeddings local (HuggingFace)
EMBED_MODEL=all-MiniLM-L6-v2

# Tamanho e sobreposição dos chunks
CHUNK_SIZE=800
CHUNK_OVERLAP=200

# Quantos chunks recuperar por query
TOP_K=4

# Endpoint da API do BitNet (OpenAI-compatible)
BITNET_ENDPOINT=http://localhost:11434/v1/chat/completions
BITNET_MODEL=bitnet-b1.58-2B-4T